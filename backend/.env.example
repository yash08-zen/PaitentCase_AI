# Copy this file to .env and fill in values. Never commit .env to source control.

# Application
APP_ENV=development
APP_SECRET_KEY=change-me-to-a-random-secret-key-at-least-32-chars
APP_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database
DATABASE_URL=sqlite+aiosqlite:///./patientcase.db

# CORS — comma-separated allowed origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# File uploads
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=20
