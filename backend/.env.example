# Copy this file to .env and fill in values. Never commit .env to source control.

# Application
APP_ENV=development
APP_SECRET_KEY=change-me-to-a-random-secret-key-at-least-32-chars
APP_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database
DATABASE_URL=sqlite+aiosqlite:///./patientcase.db

# CORS — comma-separated allowed origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# File uploads
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=20

# ── AI Clinical Insights layer ────────────────────────────────────────────
# hosted = Anthropic API (sends DE-IDENTIFIED clinical text off this machine;
#          synthetic data only), local = Ollama on this machine, mock = offline fixtures
LLM_PROVIDER=local
# Hosted mode only. Never commit a real key; .env is git-ignored.
ANTHROPIC_API_KEY=
ANTHROPIC_EXTRACTION_MODEL=claude-haiku-5-5
ANTHROPIC_REASONING_MODEL=claude-sonnet-5-5
# Local mode (Ollama, OpenAI-compatible endpoint)
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=llama3.2:3b
# Optional AI-proposed, safety-filtered follow-up interview questions
AI_FOLLOWUPS_ENABLED=false
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=3
LLM_MAX_TOKENS=4096
